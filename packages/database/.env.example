# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA

# Local development example
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentinel_rfp?schema=public"

# Docker development example
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/sentinel_rfp?schema=public"

# Production (Railway/managed PostgreSQL)
# DATABASE_URL="postgresql://user:password@host:port/database?schema=public&sslmode=require"
