# Application
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# CORS
CORS_ORIGIN=*

# Database (to be configured in next milestones)
DATABASE_URL=postgresql://user:password@localhost:5432/sentinel_rfp

# JWT Authentication (RS256 Asymmetric Signing)
# Generate keys with: bash scripts/generate-jwt-keys.sh
# Keys should be base64-encoded PEM format
JWT_PRIVATE_KEY=LS0tLS1CRUdJTi... (base64-encoded private key)
JWT_PUBLIC_KEY=LS0tLS1CRUdJTi... (base64-encoded public key)

# Sentry Error Tracking
# Get your DSN from https://sentry.io/
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Cloudflare R2 Object Storage
# Get credentials from Cloudflare Dashboard > R2 > Manage R2 API Tokens
# Account ID format: 32-character hexadecimal string
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=sentinel-rfp-documents
