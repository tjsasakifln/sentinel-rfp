# Sentinel RFP - Environment Variables Template
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sentinel_rfp?schema=public

# JWT Authentication (RS256 Asymmetric Keys)
# Generate keys using: node scripts/generate-jwt-keys.js
JWT_PRIVATE_KEY=LS0tLS1CRUdJTi... (base64-encoded RSA private key)
JWT_PUBLIC_KEY=LS0tLS1CRUdJTi... (base64-encoded RSA public key)

# ============================================================================
# AI/LLM Configuration
# ============================================================================

# Anthropic API Key
# Get your key at: https://console.anthropic.com/
# Supported models:
#   - claude-3-5-sonnet-20241022 (primary: fast, good reasoning)
#   - claude-3-opus-20240229 (fallback: best quality)
#   - claude-3-haiku-20240307 (fallback: cost-optimized)
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI API Key (optional, for embeddings and fallback)
# Get your key at: https://platform.openai.com/api-keys
# Used for:
#   - text-embedding-3-large (embeddings)
#   - gpt-4o (fallback LLM)
OPENAI_API_KEY=sk-...

# LLM Router Configuration
LLM_PRIMARY_PROVIDER=anthropic
LLM_FALLBACK_ENABLED=true
